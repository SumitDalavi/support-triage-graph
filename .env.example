# .env.example — support-triage-graph
# Copy to .env and fill in values to activate live backends. Leave blank for mock mode.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PROGRESSIVE CREDENTIAL LOADING (PCL)                                   │
# │  No keys needed to run. Add keys to unlock production-grade backends.   │
# └─────────────────────────────────────────────────────────────────────────┘

# ── AI Providers ─────────────────────────────────────────────────────────
# UNSET or sk-dummy (default): Rule-based deterministic mock classification & agents (CI-safe)
# SET to OpenAI key (sk-...): Live LangGraph routing with GPT-4o-mini structured output
OPENAI_API_KEY=

# ── Server & Port ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
